@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

foreach(_comp ${OtvSdk_FIND_COMPONENTS})
    if(_comp STREQUAL "Engine")
        find_dependency(OpenCV)
        if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/OtvEngineTargets.cmake")
            include("${CMAKE_CURRENT_LIST_DIR}/OtvEngineTargets.cmake")
            set(OtvSdk_Engine_FOUND TRUE)
        else()
            set(OtvSdk_Engine_FOUND FALSE)
        endif()
    else()
        set(OtvSdk_${_comp}_FOUND FALSE)
    endif()
endforeach()

check_required_components("OtvSdk")
