{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "host-debug",
      "displayName": "Debug",
      "description": "Debug build with test cases",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_TESTS": "ON"
      }
    },
    {
      "name": "host-release",
      "displayName": "Release",
      "description": "Release build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "rpi4b-debug",
      "displayName": "Rpi 4B Debug",
      "description": "Debug build with test cases targeting Rpi 4B",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TARGET_RPI4B": "ON",
        "ENABLE_TESTS": "ON"
      }
    },
    {
      "name": "rpi4b-release",
      "displayName": "Rpi 4B Release",
      "description": "Release build targeting Rpi 4B",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TARGET_RPI4B": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "host-release",
      "configurePreset": "host-release"
    },
    {
      "name": "rpi4b-debug",
      "configurePreset": "rpi4b-debug"
    },
    {
      "name": "rpi4b-release",
      "configurePreset": "rpi4b-release"
    }
  ]
}
